{
  "realm": "vetclinic",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 2592000,
  "accessTokenLifespanForImplicitFlow": 2592000,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 2592000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespan": 2592000,
  "accessCodeLifespan": 2592000,
  "accessCodeLifespanUserAction": 2592000,
  "accessCodeLifespanLogin": 2592000,
  "actionTokenGeneratedByAdminLifespan": 2592000,
  "actionTokenGeneratedByUserLifespan": 2592000,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Basic user with read-only access"
      },
      {
        "name": "admin",
        "description": "Administrator with full system access"
      },
      {
        "name": "vet",
        "description": "Veterinarian - can manage patients, visits, and medical records"
      },
      {
        "name": "receptionist",
        "description": "Receptionist - can manage clients, appointments, and basic patient info"
      },
      {
        "name": "accountant",
        "description": "Accountant - can manage invoices, payments, and financial reports"
      }
    ]
  },
  "clients": [
    {
      "clientId": "vetclinic-app",
      "name": "Vet Clinic Backend",
      "enabled": true,
      "publicClient": false,
      "secret": "vetclinic-secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:8080/*"],
      "webOrigins": ["http://localhost:8080"],
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "2592000",
        "client.session.idle.timeout": "2592000",
        "client.session.max.lifespan": "2592000"
      },
      "protocolMappers": [
        {
          "name": "clinic_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "clinic_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "clinic_id",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "vetclinic-frontend",
      "name": "Vet Clinic Frontend",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:3001/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:3001"],
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "2592000",
        "client.session.idle.timeout": "2592000",
        "client.session.max.lifespan": "2592000",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "clinic_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "clinic_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "clinic_id",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "user",
      "email": "user@vetclinic.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ],
      "realmRoles": ["user"],
      "attributes": {
        "clinic_id": ["00000000-0000-0000-0000-000000000001"]
      }
    },
    {
      "username": "admin",
      "email": "admin@vetclinic.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "vet", "receptionist", "accountant", "user"],
      "attributes": {
        "clinic_id": ["00000000-0000-0000-0000-000000000001"]
      }
    },
    {
      "username": "vet",
      "email": "vet@vetclinic.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Doctor",
      "lastName": "Smith",
      "credentials": [
        {
          "type": "password",
          "value": "vet",
          "temporary": false
        }
      ],
      "realmRoles": ["vet", "user"],
      "attributes": {
        "clinic_id": ["00000000-0000-0000-0000-000000000001"]
      }
    },
    {
      "username": "receptionist",
      "email": "receptionist@vetclinic.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Jane",
      "lastName": "Doe",
      "credentials": [
        {
          "type": "password",
          "value": "receptionist",
          "temporary": false
        }
      ],
      "realmRoles": ["receptionist", "user"],
      "attributes": {
        "clinic_id": ["00000000-0000-0000-0000-000000000001"]
      }
    },
    {
      "username": "accountant",
      "email": "accountant@vetclinic.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Numbers",
      "credentials": [
        {
          "type": "password",
          "value": "accountant",
          "temporary": false
        }
      ],
      "realmRoles": ["accountant", "user"],
      "attributes": {
        "clinic_id": ["00000000-0000-0000-0000-000000000001"]
      }
    }
  ]
}
