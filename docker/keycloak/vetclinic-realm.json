{
  "realm": "vetclinic",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 2592000,
  "accessTokenLifespanForImplicitFlow": 2592000,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 2592000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespan": 2592000,
  "accessCodeLifespan": 2592000,
  "accessCodeLifespanUserAction": 2592000,
  "accessCodeLifespanLogin": 2592000,
  "actionTokenGeneratedByAdminLifespan": 2592000,
  "actionTokenGeneratedByUserLifespan": 2592000,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Regular user role"
      },
      {
        "name": "admin",
        "description": "Administrator role"
      }
    ]
  },
  "clients": [
    {
      "clientId": "vetclinic-app",
      "name": "Vet Clinic Backend",
      "enabled": true,
      "publicClient": false,
      "secret": "vetclinic-secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:8080/*"],
      "webOrigins": ["http://localhost:8080"],
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "2592000",
        "client.session.idle.timeout": "2592000",
        "client.session.max.lifespan": "2592000"
      }
    },
    {
      "clientId": "vetclinic-frontend",
      "name": "Vet Clinic Frontend",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "2592000",
        "client.session.idle.timeout": "2592000",
        "client.session.max.lifespan": "2592000",
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "user",
      "email": "user@vetclinic.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "admin",
      "email": "admin@vetclinic.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "user"]
    }
  ]
}
